# --- editor and OS noise ---
**/.DS_Store
**/.Rhistory
**/.*.swp
*~
*.save

# --- Quarto working state ---
**/.quarto/
**/_freeze/
**/*.quarto_ipynb
**/__pycache__/

# --- render intermediates -------------------------------------------
# The published .html files are self-contained. These are the loose figures
# and the vendored libs that went into them, plus the packaging intermediate
# that render_gpu.sh renames over the published file.
Python-code/*_files/
#Python-code/*_standalone.html
R-code/*_files/
# Quarto 1.4 leaves the unexecuted notebook behind when a render fails, and
# render_gpu.sh parks the last published document here while it rebuilds.
Python-code/*.ipynb
Python-code/*.html.prev

# --- computation caches ---
# Fingerprinted pickle caches written by the advanced Python tutorial.
Python-code/cache_*/

# --- SGE job output ---
*.e[0-9]*
*.o[0-9]*
*.pe[0-9]*
*.po[0-9]*
*.log
